          5,
          12
        ],
        "c": [
          1,
          4
        ]
      },
      "reponse": "a-b-c",
      "unite": "€"
    },
    {
      "id": "bus",
      "chapitre": "deux-etapes",
      "operation": "modele",
      "texte": "Il y a {a} personnes dans le bus. {b} descendent, puis {c} montent. Combien sont-elles maintenant ?",
      "variables": {
        "a": [
          20,
          45
        ],
        "b": [
          3,
          15
        ],
        "c": [
          2,
          12
        ]
      },
      "reponse": "a-b+c",
      "unite": "personnes"
    },
    {
      "id": "paquets",
      "chapitre": "deux-etapes",
      "operation": "modele",
      "texte": "{p} a {k} paquets de {q} cartes et encore {r} cartes. Combien de cartes en tout ?",
      "variables": {
        "p": {
          "valeurs": [
            "Léo",
            "Inès",
            "Noah",
            "Jade",
            "Malo",
            "Lina",
            "Tom",
            "Lou"
          ]
        },
        "k": [
          2,
          5
        ],
        "q": {
          "valeurs": [
            2,
            5,
            10
          ]
        },
        "r": [
          1,
          9
        ]
      },
      "reponse": "k*q+r",
      "unite": "cartes"
    }
  ]
