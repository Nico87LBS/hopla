            5,
            6,
            10
          ]
        }
      },
      "reponse": "k*q",
      "unite": "œufs"
    },
    {
      "id": "pattes",
      "chapitre": "multiplier",
      "operation": "modele",
      "texte": "Dans le pré, il y a {k} vaches. Combien de pattes en tout ?",
      "variables": {
        "k": [
          2,
          10
        ]
      },
      "reponse": "k*4",
      "unite": "pattes"
    },
    {
      "id": "velos",
      "chapitre": "multiplier",
      "operation": "modele",
      "texte": "Dans le garage, il y a {k} vélos. Combien de roues en tout ?",
      "variables": {
        "k": [
          2,
          10
        ]
      },
      "reponse": "k*2",
      "unite": "roues"
    },
    {
      "id": "achats",
      "chapitre": "deux-etapes",
      "operation": "modele",
      "texte": "{p} a {a} €. Il achète un livre à {b} € et un stylo à {c} €. Combien lui reste-t-il ?",
      "variables": {
        "p": {
          "valeurs": [
            "Léo",
            "Noah",
            "Tom"
          ]
