  "generateurs": [
    {
      "id": "billes",
      "chapitre": "ajouter-enlever",
      "operation": "modele",
      "texte": "{p} a {a} billes. À la récréation, il en gagne {b}. Combien en a-t-il maintenant ?",
      "variables": {
        "p": {
          "valeurs": [
            "Léo",
            "Noah",
            "Tom",
            "Malo"
          ]
        },
        "a": [
          15,
          60
        ],
        "b": [
          8,
          35
        ]
      },
      "reponse": "a+b",
      "unite": "billes"
    },
    {
      "id": "pages",
      "chapitre": "ajouter-enlever",
      "operation": "modele",
      "texte": "Un livre a {a} pages. {p} en a lu {b}. Combien de pages lui reste-t-il à lire ?",
      "variables": {
        "p": {
          "valeurs": [
            "Léo",
            "Inès",
            "Noah",
            "Jade",
            "Malo",
            "Lina",
            "Tom",
            "Lou"
          ]
        },
        "a": [
          60,
          150
        ],
        "b": [
          15,
          55
        ]
      },
      "reponse": "a-b",
      "unite": "pages"
    },
    {
      "id": "ecole",
      "chapitre": "ajouter-enlever",
      "operation": "modele",
      "texte": "Dans l’école, il y a {a} filles et {b} garçons. Combien y a-t-il d’élèves ?",
      "variables": {
        "a": [
          40,
          120
        ],
        "b": [
          40,
          120
        ]
      },
      "reponse": "a+b",
      "unite": "élèves"
    },
    {
      "id": "partage",
      "chapitre": "partager",
      "operation": "modele",
      "texte": "{p} partage {n} bonbons entre {k} amis, autant pour chacun. Combien chacun en a-t-il ?",
      "variables": {
        "p": {
          "valeurs": [
            "Léo",
            "Inès",
            "Noah",
            "Jade",
            "Malo",
            "Lina",
            "Tom",
            "Lou"
          ]
        },
        "k": [
          2,
          5
        ],
        "q": [
          2,
          10
        ]
      },
      "calculs": {
        "n": "k*q"
      },
      "reponse": "q",
      "unite": "bonbons"
    },
    {
      "id": "equipes",
      "chapitre": "partager",
      "operation": "modele",
      "texte": "La classe a {n} élèves. On fait des équipes de {k}. Combien d’équipes ?",
      "variables": {
        "k": {
          "valeurs": [
            2,
            3,
            4,
            5
          ]
        },
        "q": [
          3,
          8
        ]
      },
      "calculs": {
        "n": "k*q"
      },
      "reponse": "q",
      "unite": "équipes"
    },
    {
      "id": "boites",
      "chapitre": "multiplier",
      "operation": "modele",
      "texte": "Il y a {k} boîtes de {q} œufs. Combien d’œufs en tout ?",
      "variables": {
        "k": [
          2,
          5
        ],
        "q": {
          "valeurs": [
            2,
